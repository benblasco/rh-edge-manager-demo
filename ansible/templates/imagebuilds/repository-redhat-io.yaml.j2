apiVersion: flightctl.io/v1beta1
kind: Repository
metadata:
  name: {{ rhem_oci_repo_redhat_name }}
spec:
  type: oci
  registry: {{ rhem_registry_url }}
  scheme: https
  accessMode: Read
  ociAuth:
    authType: docker
    username: {{ rhem_registry_username }}
    password: {{ rhem_registry_password }}
  baseImages:
    - imageName: {{ rhem_bootc_image_name }}
      tags:
        - "{{ rhem_bootc_image_tag }}"