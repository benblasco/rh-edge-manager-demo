---
# Copy to vault.yml, set values, then: ansible-vault encrypt inventory/group_vars/rhem_servers/vault.yml
# ansible-playbook playbooks/rhem-install-rpm.yml --ask-vault-pass

rhem_pam_password: CHANGEME
rhem_registry_username: CHANGEME
rhem_registry_password: CHANGEME

# OIDC refresh token for flightctl_image_builder* on the controller (see ansible/README.md).
rhem_flightctl_refresh_token: CHANGEME

# Optional — only when the built-image registry requires authentication (see rhem_imagebuilds.yml)
# rhem_built_registry_username: CHANGEME
# rhem_built_registry_password: CHANGEME

# bootc-image-builder config.toml user password (advanced QCOW2 export)
rhem_advanced_qcow2_user_password: CHANGEME
